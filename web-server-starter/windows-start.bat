
@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Local Website Launcher

rem ==========================================
rem CONFIGURATION
rem ==========================================

set "OWNER=tojefin"
set "REPO=kinofree"
set "BRANCH=gh-pages"

set "PYTHON_VERSION=3.13.17"
set "PORT=8080"
set "ROOT_DIR=%~dp0"
set "CHECK_UPDATES=0"
set "OPEN_BROWSER=1"
if /I "%~1"=="--update" set "CHECK_UPDATES=1"
if /I "%~2"=="--update" set "CHECK_UPDATES=1"
if /I "%~1"=="--no-browser" set "OPEN_BROWSER=0"
if /I "%~2"=="--no-browser" set "OPEN_BROWSER=0"

set "PYTHON_DIR=%~dp0python"
set "SITE_DIR=%~dp0site"
set "TEMP_DIR=%~dp0temp"
set "VERSION_FILE=%~dp0version.txt"

set "PYTHON_ZIP=%~dp0python.zip"
set "SITE_ZIP=%~dp0site.zip"

set "API_URL=https://api.github.com/repos/%OWNER%/%REPO%/tags"
set "SITE_URL=https://github.com/%OWNER%/%REPO%/archive/refs/heads/%BRANCH%.zip"

cd /d "%~dp0"

echo.
echo ==========================================
echo         LOCAL WEBSITE LAUNCHER
echo ==========================================
echo.

rem ==========================================
rem DETECT ARCHITECTURE
rem ==========================================

set "ARCH=%PROCESSOR_ARCHITECTURE%"

if defined PROCESSOR_ARCHITEW6432 (
    set "ARCH=%PROCESSOR_ARCHITEW6432%"
)

if /I "%ARCH%"=="AMD64" set "PYTHON_ARCH=amd64"
if /I "%ARCH%"=="x86" set "PYTHON_ARCH=win32"
if /I "%ARCH%"=="ARM64" set "PYTHON_ARCH=arm64"

if not defined PYTHON_ARCH (
    echo ERROR: Unsupported architecture: %ARCH%
    goto error
)

rem ==========================================
rem DOWNLOAD PYTHON
rem ==========================================

if exist "%PYTHON_DIR%\python.exe" goto python_ready

echo Downloading portable Python...

set "PYTHON_URL=https://www.python.org/ftp/python/%PYTHON_VERSION%/python-%PYTHON_VERSION%-embed-%PYTHON_ARCH%.zip"

powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; Invoke-WebRequest -UseBasicParsing -Uri $env:PYTHON_URL -OutFile $env:PYTHON_ZIP -TimeoutSec 60"

if errorlevel 1 goto error

powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; Expand-Archive -LiteralPath $env:PYTHON_ZIP -DestinationPath $env:PYTHON_DIR -Force"

if errorlevel 1 goto error

del "%PYTHON_ZIP%"

:python_ready


rem ==========================================
rem CREATE SERVER SCRIPT
rem ==========================================

set "SERVER_FILE=%~dp0server.py"
if not exist "%SERVER_FILE%" goto create_server

rem Upgrade only the exact server generated by the previous launcher.
rem Keep a custom server.py intact.
powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $legacy=@('d362c81f0116e4b666e2a18e03de49b0eaa9329f86f7935f8ed321f919fa5dae','b7a38fed580c4d665d2d19dbe3afe119024a9d7c5d38883b108ee5e56b95f9e3'); if ($legacy -contains (Get-FileHash -LiteralPath $env:SERVER_FILE -Algorithm SHA256).Hash.ToLowerInvariant()) { exit 0 }; exit 1"
if errorlevel 1 goto server_ready

echo Updating generated server.py...

:create_server
set "SERVER_STAGE=%~dp0.server-%RANDOM%-%RANDOM%.py"
if exist "%SERVER_STAGE%" goto create_server

echo Creating server.py...

@echo off
(
echo import os
echo import sys
echo from http.server import HTTPServer, SimpleHTTPRequestHandler
echo.
echo ROOT = os.path.join^(os.path.dirname^(__file__^), "site"^)
echo HOST = "0.0.0.0"
echo PORT = int^(sys.argv[1]^) if len^(sys.argv^) ^> 1 else 8080
echo.
echo class Handler^(SimpleHTTPRequestHandler^):
echo     def __init__^(self, *args, **kwargs^):
echo         super^(^).__init__^(*args, directory=ROOT, **kwargs^)
echo.
echo     def translate_path^(self, path^):
echo         path = super^(^).translate_path^(path^)
echo.
echo         if os.path.isfile^(path^) or os.path.isdir^(path^):
echo             return path
echo.
echo         if not os.path.splitext^(path^)[1]:
echo             html_path = path + ".html"
echo             if os.path.isfile^(html_path^):
echo                 return html_path
echo.
echo         return path
echo.
echo     def log_message^(self, format, *args^):
echo         pass
echo.
echo if __name__ == "__main__":
echo     try:
echo         HTTPServer^((HOST, PORT^), Handler^).serve_forever^(^)
echo     except KeyboardInterrupt:
echo         print^('Server stopped', flush=True^)
) > "%SERVER_STAGE%"
if errorlevel 1 goto error

powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $base=[IO.Path]::GetFullPath($env:ROOT_DIR).TrimEnd([char]92); $stage=[IO.Path]::GetFullPath($env:SERVER_STAGE); $target=[IO.Path]::GetFullPath($env:SERVER_FILE); foreach ($path in @($stage,$target)) { if (!$path.StartsWith($base+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Server path escaped launcher root' } }; if (Test-Path -LiteralPath $target) { if ((Get-Item -LiteralPath $target).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Server file is a reparse point' }; [IO.File]::Replace($stage,$target,[System.Management.Automation.Language.NullString]::Value) } else { [IO.File]::Move($stage,$target) }"
if errorlevel 1 goto error

echo server.py created successfully!

:server_ready

rem A cached installation must not depend on GitHub or a tag lookup.
if "%CHECK_UPDATES%"=="0" if exist "%SITE_DIR%\index.html" goto cached_site_ready


rem ==========================================
rem CHECK LATEST GITHUB TAG
rem ==========================================

echo.
echo Checking latest version...

set "LATEST_TAG="

for /f "usebackq delims=" %%A in (`powershell -NoProfile -Command ^
 "$ProgressPreference='SilentlyContinue'; try { $tags=Invoke-RestMethod -Uri $env:API_URL -Headers @{'User-Agent'='LocalWebsiteLauncher'} -TimeoutSec 10; if ($tags.Count -gt 0 -and $tags[0].name -match '^[A-Za-z0-9._-]{1,64}$') { $tags[0].name } } catch { exit 1 }"`) do (
    set "LATEST_TAG=%%A"
)

if not defined LATEST_TAG (
    if exist "%SITE_DIR%\index.html" (
        echo WARNING: GitHub is unavailable. Starting the installed website.
        goto cached_site_ready
    )
    echo ERROR: Could not retrieve GitHub tag.
    goto error
)

set "CURRENT_TAG="

if exist "%VERSION_FILE%" (
    set /p CURRENT_TAG=<"%VERSION_FILE%"
)

echo Local version: %CURRENT_TAG%
echo Latest version: %LATEST_TAG%

if /I "%CURRENT_TAG%"=="%LATEST_TAG%" (
    if exist "%SITE_DIR%\index.html" (
        echo.
        echo Website is up to date.
        goto site_ready
    )
)

rem ==========================================
rem DOWNLOAD LATEST GH-PAGES BUILD
rem ==========================================

echo.
echo Updating website from gh-pages...

powershell.exe -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $base=[IO.Path]::GetFullPath($env:ROOT_DIR).TrimEnd([char]92); $temp=[IO.Path]::GetFullPath($env:TEMP_DIR); if (!$temp.StartsWith($base+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Temporary path escaped launcher root' }; if (Test-Path -LiteralPath $temp) { if ((Get-Item -LiteralPath $temp).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Temporary folder is a reparse point' }; Remove-Item -LiteralPath $temp -Recurse -Force }; New-Item -ItemType Directory -Path $temp | Out-Null"
if errorlevel 1 goto site_update_error

powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; Invoke-WebRequest -UseBasicParsing -Uri $env:SITE_URL -OutFile $env:SITE_ZIP -TimeoutSec 60"

if errorlevel 1 goto site_update_error

powershell -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $base=[IO.Path]::GetFullPath($env:ROOT_DIR).TrimEnd([char]92); function CheckedPath($path) { $full=[IO.Path]::GetFullPath($path); if (!$full.StartsWith($base+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Path escaped launcher root' }; return $full }; $temp=CheckedPath $env:TEMP_DIR; $site=CheckedPath $env:SITE_DIR; Add-Type -AssemblyName System.IO.Compression.FileSystem; $archive=[IO.Compression.ZipFile]::OpenRead($env:SITE_ZIP); try { foreach ($entry in $archive.Entries) { $target=[IO.Path]::GetFullPath([IO.Path]::Combine($temp,$entry.FullName)); if (!$target.StartsWith($temp+'\',[StringComparison]::OrdinalIgnoreCase) -or $entry.FullName.Contains(':')) { throw 'Unsafe archive entry' } } } finally { $archive.Dispose() }; Expand-Archive -LiteralPath $env:SITE_ZIP -DestinationPath $temp -Force; $root=Get-ChildItem -LiteralPath $temp -Directory | Select-Object -First 1; if (!$root -or !(Test-Path -LiteralPath (Join-Path $root.FullName 'index.html') -PathType Leaf)) { throw 'Archive does not contain index.html' }; $source=CheckedPath $root.FullName; $backup=CheckedPath (Join-Path $base ('.site-backup-'+[guid]::NewGuid().ToString('N'))); $moved=$false; try { if (Test-Path -LiteralPath $site) { if ((Get-Item -LiteralPath $site).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Site folder is a reparse point' }; Move-Item -LiteralPath $site -Destination $backup; $moved=$true }; Move-Item -LiteralPath $source -Destination $site } catch { if ($moved -and !(Test-Path -LiteralPath $site)) { Move-Item -LiteralPath $backup -Destination $site }; throw }; if ($moved) { Remove-Item -LiteralPath $backup -Recurse -Force }"

if errorlevel 1 goto site_update_error

echo %LATEST_TAG%>"%VERSION_FILE%"

powershell.exe -NoProfile -Command ^
 "$ErrorActionPreference='Stop'; $base=[IO.Path]::GetFullPath($env:ROOT_DIR).TrimEnd([char]92); foreach ($path in @($env:SITE_ZIP,$env:TEMP_DIR)) { $full=[IO.Path]::GetFullPath($path); if (!$full.StartsWith($base+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Cleanup path escaped launcher root' }; if (Test-Path -LiteralPath $full) { Remove-Item -LiteralPath $full -Recurse -Force } }"

echo Website updated to %LATEST_TAG%.
goto site_ready

:site_update_error
if exist "%SITE_DIR%\index.html" (
    echo WARNING: Update failed. Starting the installed website.
    goto cached_site_ready
)
goto error

:cached_site_ready
set "LATEST_TAG=local"
if exist "%VERSION_FILE%" set /p LATEST_TAG=<"%VERSION_FILE%"

:site_ready


rem ==========================================
rem START SERVER
rem ==========================================

echo.
echo ==========================================
echo Website: http://localhost:%PORT%
echo Version: %LATEST_TAG%
echo Press CTRL+C to stop the server.
echo ==========================================
echo.

rem Verify the intended site's bytes, not merely an open TCP port.
set "HEALTH_COMMAND=function Test-LocalSite { try { $file=Join-Path $env:SITE_DIR 'index.html'; $bytes=[IO.File]::ReadAllBytes($file); $sha=[Security.Cryptography.SHA256]::Create(); try { $want=[Convert]::ToBase64String($sha.ComputeHash($bytes)); $req=[Net.HttpWebRequest]::Create('http://127.0.0.1:'+$env:PORT+'/'); $req.Timeout=500; $req.ReadWriteTimeout=500; $req.AllowAutoRedirect=$false; $res=$req.GetResponse(); try { if ([int]$res.StatusCode -ne 200 -or $res.ContentLength -ne $bytes.Length) { return $false }; $got=[Convert]::ToBase64String($sha.ComputeHash($res.GetResponseStream())); return $got -eq $want } finally { $res.Close() } } finally { $sha.Dispose() } } catch { return $false } }"
powershell.exe -NoProfile -Command "%HEALTH_COMMAND%; if (Test-LocalSite) { exit 0 }; exit 1"
if not errorlevel 1 (
    echo The installed website is already running.
    if "%OPEN_BROWSER%"=="1" start "" "http://localhost:%PORT%"
    goto end
)

if "%OPEN_BROWSER%"=="1" start "" powershell.exe -NoProfile -WindowStyle Hidden -Command "%HEALTH_COMMAND%; $deadline=[DateTime]::UtcNow.AddSeconds(15); while ([DateTime]::UtcNow -lt $deadline) { if (Test-LocalSite) { Start-Process -FilePath ('http://localhost:'+$env:PORT) -WindowStyle Normal; exit 0 }; Start-Sleep -Milliseconds 100 }; exit 1"

"%PYTHON_DIR%\python.exe" -u "%SERVER_FILE%" %PORT%
if errorlevel 1 goto error

echo.
echo Server stopped.
pause

goto end

:error
echo.
echo ==========================================
echo ERROR OCCURRED!
echo Existing website files have been preserved
echo unless an error occurred during replacement.
echo ==========================================
pause
exit /b 1

:end
endlocal
