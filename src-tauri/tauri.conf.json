{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kinofree",
  "version": "5.0.10",
  "identifier": "su.kinofree.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:80",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kinofree",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProxy --host-rules=\"MAP *.doubleclick.net ~NOTFOUND,MAP *.googlesyndication.com ~NOTFOUND,MAP *.googleadservices.com ~NOTFOUND,MAP *.adriver.ru ~NOTFOUND,MAP *.adfox.ru ~NOTFOUND,MAP an.yandex.ru ~NOTFOUND,MAP awaps.yandex.net ~NOTFOUND,MAP *.adhigh.net ~NOTFOUND,MAP *.betweendigital.com ~NOTFOUND,MAP *.adsniper.ru ~NOTFOUND,MAP *.admixer.net ~NOTFOUND,MAP *.bumlam.com ~NOTFOUND,MAP *.alloviewroll.com ~NOTFOUND\""
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMEVGNUFGNjQ0MDhDN0MKUldSOGpFQmtyL1VPb25SMkF3U0NuR2NtV283aUJtWVJSM1Nnc24zaEY5aTNFbFBtSXBlbUZKc1kK",
      "endpoints": [
        "https://github.com/Tojefin/kinofree/releases/latest/download/latest.json"
      ]
    }
  }
}
